# ─────────────────────────────────────────────────────────────────────────────
# biz-nexus — environment template
#
# Copy to .env.local and fill in.  .env* is gitignored; this file is not.
#   cp .env.example .env.local
#
# Every variable below is validated at startup by src/env.ts. A missing
# required variable, or a placeholder value still present in production,
# causes the application to fail loudly on boot rather than degrade silently.
# See docs/SECURITY.md §8.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="BizNexus"
# Public origin. Used for absolute URLs in metadata, password-reset links and
# Origin-header validation. No trailing slash.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Development: the MongoDB instance already running locally.
MONGODB_URI=mongodb://127.0.0.1:27017/biz_nexus
# Production: MongoDB Atlas SRV string. Set via the Vercel dashboard, never
# committed. The serverless-safe connection options (pool size, timeouts,
# bufferCommands) are set in code — see docs/DATABASE.md §11.
#
# IMPORTANT: local development must run MongoDB as a single-node replica set for
# multi-document transactions (lead conversion) to be available:
#   mongod --replSet rs0
#   mongosh --eval "rs.initiate()"

# ── Sessions ─────────────────────────────────────────────────────────────────
# 32+ bytes of entropy. Generate with:  openssl rand -base64 32
# Sessions are opaque database-backed tokens, so this secret is NOT used to sign
# them. It signs short-lived stateless tokens: email verification and password
# reset links. Rotating it invalidates outstanding reset links and nothing else.
SESSION_SECRET=replace-with-openssl-rand-base64-32

# ── Mail ─────────────────────────────────────────────────────────────────────
# Driver selection: console | resend | smtp
# "console" prints the message to the server log and is DEVELOPMENT ONLY. The
# application refuses to start with MAIL_DRIVER=console when NODE_ENV=production.
MAIL_DRIVER=console
MAIL_FROM="BizNexus <no-reply@example.com>"
# Required when MAIL_DRIVER=resend or smtp
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Driver selection: memory | redis
# "memory" is per-instance on Vercel. It is sufficient for MVP abuse resistance
# and is NOT a security boundary. Install the Upstash Redis driver before this
# product handles real money. See docs/SECURITY.md §9 and §12.
RATELIMIT_DRIVER=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Future stages — not required for the MVP ────────────────────────────────
# These are read only once the corresponding stage is implemented. Declaring
# them now keeps the .env contract stable as the product grows.
# STAGE 10 — object storage for documents
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# STAGE 7 — background jobs for the automation engine
# QUEUE_DRIVER=qstash
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# STAGE 3 — transactional email for invoices and payment receipts
# STAGE 12 — SaaS billing (separate from customer Finance, see docs/PRODUCT.md)
# BILLING_PROVIDER=
